{
  "name": "dsh-chinese-language",
  "version": "0.2.0",
  "description": "DeepSeek Harness plugin: keep agents reasoning and answering in Simplified Chinese with a token-lean system-prompt section plus a one-line runtime-context reminder that also reaches long or resumed sessions.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "README.zh.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "check": "node --check lib/index.js",
    "test": "node --test"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "plugin",
    "chinese",
    "system-prompt",
    "runtime-context",
    "language"
  ],
  "license": "MIT",
  "author": "fzy3232",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fzy3232/dsh-chinese-language.git"
  },
  "homepage": "https://github.com/fzy3232/dsh-chinese-language#readme",
  "bugs": {
    "url": "https://github.com/fzy3232/dsh-chinese-language/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
